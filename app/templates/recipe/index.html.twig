{% extends 'base.html.twig' %}

{% block title %}Cookbook{% endblock %}

{% block body %}
    <div class="container bg-dark">
        <div class="d-flex justify-content-between align-items-center pt-3 pb-2">
            <h1 class="text-light mb-0">Cookbook</h1>
            <div class="d-flex gap-2">
                <a href="{{ path('shopping_list_index') }}" class="btn btn-outline-light btn-sm">Shopping List</a>
                <a href="/admin" class="btn btn-outline-secondary btn-sm">Admin ↗</a>
            </div>
        </div>

        {# Filter bar #}
        <div class="mb-4">
            <div class="row g-2">
                <div class="col-12">
                    <span class="text-light fw-semibold small me-2">Course</span>
                    {% for course in allCourses %}
                        {% set newCourses = course.value in selectedCourses
                            ? selectedCourses|filter(v => v != course.value)
                            : selectedCourses|merge([course.value]) %}
                        <a href="{{ path('home', {'courses[]': newCourses, 'categories[]': selectedCategories}) }}"
                           class="btn btn-sm me-1 {{ course.value in selectedCourses ? 'btn-primary' : 'btn-outline-light' }}">
                            {{ course.label() }}
                        </a>
                    {% endfor %}
                </div>
                <div class="col-12">
                    <span class="text-light fw-semibold small me-2">Category</span>
                    {% for category in allCategories %}
                        {% set newCategories = category.value in selectedCategories
                            ? selectedCategories|filter(v => v != category.value)
                            : selectedCategories|merge([category.value]) %}
                        <a href="{{ path('home', {'courses[]': selectedCourses, 'categories[]': newCategories}) }}"
                           class="btn btn-sm me-1 {{ category.value in selectedCategories ? 'btn-primary' : 'btn-outline-light' }}">
                            {{ category.label() }}
                        </a>
                    {% endfor %}
                </div>
                {% if selectedCourses|length > 0 or selectedCategories|length > 0 %}
                    <div class="col-12">
                        <a href="{{ path('home') }}" class="btn btn-sm btn-outline-danger">Clear filters</a>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="row row row-cols-1 row-cols-md-3 g-4">
        {% for recipe in recipes %}
            <div class="col h-100">
            <div class="card">
                {% if recipe.image %}
                <img src="{{ recipe.image starts with 'https' ? recipe.image : (recipe.image|aws_url) }}" class="card-img-top" alt="{{ recipe.name }}">
                {% endif %}
                <div class="card-body bg-light">
                    <h5 class="card-title">{{ recipe.name }}</h5>
                    <p class="card-text">{{ recipe.description}}</p>
                    <a href="{{ path('recipe_show', {'slug': recipe.slug}) }}" class="btn btn-primary">Show</a>
                    {% if recipe.id in shoppingListRecipeIds %}
                        <form method="post" action="{{ path('shopping_list_remove', {'id': recipe.id}) }}" class="d-inline">
                            <button type="submit" class="btn btn-danger">Remove from List</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('shopping_list_add', {'id': recipe.id}) }}" class="d-inline">
                            <button type="submit" class="btn btn-success">Add to Shopping List</button>
                        </form>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        {% if recipe.mastered %}
                            <i class="fa fa-check-circle mastered"></i>
                        {% endif %}
                        {% if recipe.mistakes | length > 0 %}
                            {{ recipe.mistakes|length }} mistakes.
                        {% endif %}
                    </small>
                </div>
            </div>
            </div>
        {% else %}
            <p class="text-light">No recipes found.</p>
        {% endfor %}
        </div>
    </div>
{% endblock %}

